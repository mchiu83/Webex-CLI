# Webex API credentials
# Copy this file to credentials.priv and fill in your values.
#
# token: Your personal access token from https://developer.webex.com
#   - Sign in with your Webex admin account
#   - Click your profile avatar (top-right) to reveal and copy your token
#   - Tokens expire after 12 hours — refresh as needed
#
# orgid: Your Webex Organization ID
#   - Found in Control Hub under Account > Organization ID
#   - If left blank, the CLI will auto-detect it on startup

token=
orgid=
